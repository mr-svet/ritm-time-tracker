# Copy this file to .env, then paste your BotFather token locally.
# Never commit .env or paste the token into a chat.
TELEGRAM_BOT_TOKEN=
# Local development: leave these unset. Dokploy injects production values.
# NODE_ENV=production
# APP_ORIGIN=https://ritmday.space
# Dokploy: resolve the exact Traefik peer through internal Docker DNS.
# TRUSTED_PROXY_HOSTS=dokploy-traefik
# Alternatively use TRUSTED_PROXY_IPS with exact IPv4/IPv6 addresses.
# Never set both options; never trust an entire network.
# HOST=0.0.0.0
# DATA_DIR=/app/data
# BACKUP_DIR=/app/backups

# Enable only after HTTPS /tg and Telegram-client verification. Uses the existing bot.
MINI_APP_ENABLED=0

# Isolated HTTPS test copy only: no getUpdates, messages or automatic menu changes.
# TELEGRAM_POLLING_ENABLED=0
# APP_PATH_PREFIX=/miniapp-test
